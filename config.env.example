# AirRadio v0.6 — copy to config.env and edit.
# Paths and secrets live here, not in scripts.
# Existing environment variables win (VAR="${VAR:-default}").

# Radio (Nostalgie Vlaanderen / Play Nostalgie)
RADIO_URL="${RADIO_URL:-https://playerservices.streamtheworld.com/api/livestream-redirect/NOSTALGIEWHATAFEELING.mp3}"
RADIO_NAME="${RADIO_NAME:-Nostalgie Vlaanderen}"
# Pi Zero W + KMS: vc4hdmi. Legacy firmware-kms often shows as b1.
# Discover with: aplay -l   and   cat /proc/asound/cards
RADIO_ALSA="${RADIO_ALSA:-hdmi:CARD=vc4hdmi,DEV=0}"
RADIO_VOLUME="${RADIO_VOLUME:-80}"

# OpenSky fetch bbox (~100 km around home 50.8950 N, 2.6963 E)
OPENSKY_URL="${OPENSKY_URL:-https://opensky-network.org/api/states/all}"
LAMIN="${LAMIN:-50.00}"
LAMAX="${LAMAX:-51.79}"
LOMIN="${LOMIN:-0.16}"
LOMAX="${LOMAX:-5.23}"
POLL_SECONDS="${POLL_SECONDS:-25}"
# Anonymous ~400/day; 25s is ~3456/day and will 429.
# Registered (4000/day): create an API client on https://opensky-network.org/my-opensky/account
# and set client_id / client_secret. Tokens are fetched and cached automatically (~30 min).
OPENSKY_TOKEN_URL="${OPENSKY_TOKEN_URL:-https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token}"
OPENSKY_CLIENT_ID="${OPENSKY_CLIENT_ID:-}"
OPENSKY_CLIENT_SECRET="${OPENSKY_CLIENT_SECRET:-}"
# Optional static Bearer. Unused when client_id/secret are set. Tokens expire in ~30 min.
OPENSKY_TOKEN="${OPENSKY_TOKEN:-}"

SKIP_GROUND="${SKIP_GROUND:-1}"
MAX_AIRCRAFT="${MAX_AIRCRAFT:-40}"
# Callsign → IATA pair (BRU - NCE). Cached; unknown callsigns keep the flight number.
ROUTE_API="${ROUTE_API:-https://api.adsbdb.com/v0/callsign}"
ROUTE_LOOKUPS_PER_CYCLE="${ROUTE_LOOKUPS_PER_CYCLE:-4}"

# Map image extent (~75 km) — overwritten by map.extent.env after a Google bake
MAP_SRC="${MAP_SRC:-/opt/airradio/map.png}"
FRAME_OUT="${FRAME_OUT:-/tmp/airradio-frame.png}"
MAP_LAMIN="${MAP_LAMIN:-50.22}"
MAP_LAMAX="${MAP_LAMAX:-51.57}"
MAP_LOMIN="${MAP_LOMIN:-0.80}"
MAP_LOMAX="${MAP_LOMAX:-4.60}"
HOME_LAT="${HOME_LAT:-50.8950}"
HOME_LON="${HOME_LON:-2.6963}"

# Google Maps Static API (terrain). Required to bake a real Google map.
# Enable Maps Static API on a billed GCP project, then paste the key.
GOOGLE_MAPS_API_KEY="${GOOGLE_MAPS_API_KEY:-}"

# Display
FB_DEVICE="${FB_DEVICE:-/dev/fb0}"
FBI_TTY="${FBI_TTY:-1}"
FONT="${FONT:-/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf}"
