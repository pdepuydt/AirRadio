[Unit]
Description=AirRadio HDMI framebuffer display
After=local-fs.target

[Service]
Type=simple
User=root
Environment=AIRRADIO_ROOT=/opt/airradio
WorkingDirectory=/opt/airradio
ExecStart=/opt/airradio/scripts/display-hold.sh
Restart=always
RestartSec=2
Nice=10

[Install]
WantedBy=multi-user.target
